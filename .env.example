# Documentazione soltanto: la CLI non carica automaticamente questo file.
# Il bot esistente è @nuno_agent_bot. Non avviare un secondo gateway ora.
# Token e identity allowlist restano nella configurazione Hermes esistente.
# L'ID approvatore deve essere lo stesso unico ID di TELEGRAM_ALLOWED_USERS
# e va passato esplicitamente in mcp_servers.jarvis.env in config.yaml.
# Serve solo a simulate_with_approval; gli altri quattro tool sono in sola lettura.
JARVIS_APPROVER_ID=123456789
# Adapter Jev/TypeSafe: NON usato. Attivabile solo in futuro impostando entrambe
# le variabili; senza JEV_ENDPOINT_URL il router applica il fallback conservativo.
# JEV_ENDPOINT_URL=http://localhost:8080/classify
# JEV_API_KEY=
# Solo quando il vault sarà disponibile sul computer:
# JARVIS_VAULT_PATH=/percorso/assoluto/jarvis-vault

# Host consentiti a read_web_page anche se risolvono a indirizzi locali/privati
# (es. un dev server). Default: nessuno. Separati da virgola, solo hostname.
# JARVIS_WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# === Google Calendar (issue #23 / JARVIS-23, J16) — sezione ad hoc ===
# Scope: https://www.googleapis.com/auth/calendar.readonly (sola lettura).
# I valori veri vanno in .env locale (ignorato da Git) o in
# mcp_servers.jarvis.env di ~/.hermes/config.yaml. MAI in questo file,
# MAI nel vault, MAI nei log. Senza credenziali calendar_search fallisce
# chiuso (PROVIDER_NOT_CONFIGURED); draft_calendar_event resta locale.
# Opzione A (token breve, ~1h): basta ACCESS_TOKEN.
# Opzione B (rinnovo automatico): serve la tripletta ID + SECRET + REFRESH_TOKEN.
# GOOGLE_CALENDAR_ACCESS_TOKEN=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# JARVIS_CALENDAR_TIMEZONE=Europe/Rome

# === Email (issue #25 & #26 / JARVIS-25 & JARVIS-26, J16) — sezione ad hoc ===
# Supporto Yahoo Mail e provider IMAP/SMTP standard via SSL.
# I valori veri vanno in .env locale (ignorato da Git) o in
# mcp_servers.jarvis.env di ~/.hermes/config.yaml. MAI in questo file,
# MAI nel vault, MAI nei log. Senza credenziali email_search ed email_send falliscono
# chiusi (PROVIDER_NOT_CONFIGURED); draft_email_reply resta locale.
# Per Yahoo Mail: genera una 'Password per le app' nella sicurezza Yahoo.
# YAHOO_EMAIL=
# YAHOO_APP_PASSWORD=
# JARVIS_EMAIL_IMAP_HOST=imap.mail.yahoo.com
# JARVIS_EMAIL_IMAP_PORT=993
# JARVIS_EMAIL_SMTP_HOST=smtp.mail.yahoo.com
# JARVIS_EMAIL_SMTP_PORT=465
# JARVIS_EMAIL_SMTP_STARTTLS=0

# Ricerca web (ADR 0009: exa -> tavily). Chiavi segrete solo qui, mai nel vault né nei log.
# JARVIS_SEARCH_PROVIDERS=exa,tavily
# EXA_API_KEY=
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SEARXNG_BASE_URL=http://localhost:8080
# EXA_SEARCH_TYPE=fast
# JARVIS_SEARCH_CACHE_TTL_SECONDS=900
# JARVIS_SEARCH_DAILY_LIMIT=50
# JARVIS_SEARCH_MONTHLY_LIMIT=1000
